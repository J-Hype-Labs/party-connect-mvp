    "test:e2e:full": "npx playwright test tests/comprehensive.spec.js --reporter=html",
    "test:party-connect": "npx playwright test tests/party-connect-page.spec.js --reporter=list"
  },
  "devDependencies": {
    "@babel/parser": "^7.23.0",
    "@playwright/test": "^1.40.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/J-Hype-Labs/party-connect-mvp.git"
  },
  "homepage": "https://j-hype-labs.github.io/party-connect-mvp/"
}